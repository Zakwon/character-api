<#import "layout.ftlh" as layout>
<@layout.page title="Not Found">

    <div class="error-box">
        <h1>Character not found</h1>
        <p>We couldn't find that character. It may have been removed, or the link may be wrong.</p>
        <p><a href="/">Back to the gallery</a></p>
    </div>

</@layout.page>